{
  "expo": {
    "name": "Career Go",
    "slug": "career-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "careergo",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.careergo.mobile"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/icon.png",
      "package": "com.careergo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.139373810157-b0cdkq0avp21fg2s3f7dm78j4c0cq8sl"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b00ee54a-6444-4ab6-ae07-6d7cb2abe2d4"
      }
    },
    "owner": "traum"
  }
}
